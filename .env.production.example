# Copy this file to .env.production on the EC2 instance. Never commit that file.
POSTGRES_USER=golfiq_user
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=golfiq

# Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-output-from-openssl
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
LOG_LEVEL=INFO

# The only application port published by the production Compose file.
API_PORT=8000
